{
  "name": "@cours-de-la-souris/worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "build": "tsc",
    "preview": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.4.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-kv": "^0.0.10",
    "@cloudflare/workers-r2": "^0.0.10",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.24.0"
  }
}